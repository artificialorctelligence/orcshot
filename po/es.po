#: src/orcshot/ui/editor_window.py:5717
msgid ""
"${YYYY} year, 4 digits\n"
"${MM} month, 2 digits\n"
"${DD} day, 2 digits\n"
"${hh} hour, 2 digits\n"
"${mm} minute, 2 digits\n"
"${ss} second, 2 digits\n"
"${NUM} incrementing number, 6 digits (see Counter below)\n"
"${RRR...} random alphanumerics, same length as the number of R's\n"
"${title} capture title, when available\n"
"${\"affix\"?TOKEN} renders affix+value only when TOKEN has one, e.g. ${\" - "
"\"?title} for \" - My Window\" - or nothing at all if there's no title\n"
"\n"
"%Y year, %y year (2 digits)\n"
"%m month, %d day\n"
"%H hour (24h), %I hour (12h), %p AM/PM\n"
"%M minute, %S second\n"
"%A/%a weekday name, %B/%b month name\n"
"%% a literal percent sign"
msgstr ""
"${YYYY} año, 4 dígitos\n"
"${MM} mes, 2 dígitos\n"
"${DD} día, 2 dígitos\n"
"${hh} hora, 2 dígitos\n"
"${mm} minuto, 2 dígitos\n"
"${ss} segundo, 2 dígitos\n"
"${NUM} número incremental, 6 dígitos (véase Contador más abajo)\n"
"${RRR...} caracteres alfanuméricos aleatorios, tantos como erres se "
"escriban\n"
"${title} título de la captura, cuando esté disponible\n"
"${\"afijo\"?TOKEN} muestra el afijo junto al valor solo cuando TOKEN tiene "
"uno, p. ej. ${\" - \"?title} da \" - Mi ventana\", o nada en absoluto si no "
"hay título\n"
"\n"
"%Y año, %y año (2 dígitos)\n"
"%m mes, %d día\n"
"%H hora (24 h), %I hora (12 h), %p AM/PM\n"
"%M minuto, %S segundo\n"
"%A/%a nombre del día de la semana, %B/%b nombre del mes\n"
"%% un signo de porcentaje literal"

