#: src/orcshot/ui/editor_window.py:5713
msgid "Filename pattern placeholders and codes"
msgstr "Marqueurs et codes du modèle de nom de fichier"

#: src/orcshot/ui/editor_window.py:5715
msgid ""
"${YYYY} year, 4 digits\n"
"${MM} month, 2 digits\n"
"${DD} day, 2 digits\n"
"${hh} hour, 2 digits\n"
"${mm} minute, 2 digits\n"
"${ss} second, 2 digits\n"
"${NUM} incrementing number, 6 digits (see Counter below)\n"
"${RRR...} random alphanumerics, same length as the number of R's\n"
"${title} capture title, when available\n"
"${\"affix\"?TOKEN} renders affix+value only when TOKEN has one, e.g. ${\" - "
"\"?title} for \" - My Window\" - or nothing at all if there's no title\n"
"\n"
"%Y year, %y year (2 digits)\n"
"%m month, %d day\n"
"%H hour (24h), %I hour (12h), %p AM/PM\n"
"%M minute, %S second\n"
"%A/%a weekday name, %B/%b month name\n"
"%% a literal percent sign"
msgstr ""
"${YYYY} année, 4 chiffres\n"
"${MM} mois, 2 chiffres\n"
"${DD} jour, 2 chiffres\n"
"${hh} heure, 2 chiffres\n"
"${mm} minute, 2 chiffres\n"
"${ss} seconde, 2 chiffres\n"
"${NUM} numéro incrémenté, 6 chiffres (voir Compteur ci-dessous)\n"
"${RRR...} caractères alphanumériques aléatoires, autant qu'il y a de R\n"
"${title} titre de la capture, lorsqu'il est disponible\n"
"${\"affix\"?TOKEN} n'affiche l'affixe et la valeur que si TOKEN en possède "
"une, par exemple ${\" - \"?title} donne \" - Ma fenêtre\" - ou rien du tout "
"s'il n'y a pas de titre\n"
"\n"
"%Y année, %y année (2 chiffres)\n"
"%m mois, %d jour\n"
"%H heure (24 h), %I heure (12 h), %p AM/PM\n"
"%M minute, %S seconde\n"
"%A/%a nom du jour, %B/%b nom du mois\n"
"%% un signe pourcent littéral"

