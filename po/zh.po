#: src/orcshot/ui/editor_window.py:5717
msgid ""
"${YYYY} year, 4 digits\n"
"${MM} month, 2 digits\n"
"${DD} day, 2 digits\n"
"${hh} hour, 2 digits\n"
"${mm} minute, 2 digits\n"
"${ss} second, 2 digits\n"
"${NUM} incrementing number, 6 digits (see Counter below)\n"
"${RRR...} random alphanumerics, same length as the number of R's\n"
"${title} capture title, when available\n"
"${\"affix\"?TOKEN} renders affix+value only when TOKEN has one, e.g. ${\" - "
"\"?title} for \" - My Window\" - or nothing at all if there's no title\n"
"\n"
"%Y year, %y year (2 digits)\n"
"%m month, %d day\n"
"%H hour (24h), %I hour (12h), %p AM/PM\n"
"%M minute, %S second\n"
"%A/%a weekday name, %B/%b month name\n"
"%% a literal percent sign"
msgstr ""
"${YYYY} 年份，4 位数字\n"
"${MM} 月份，2 位数字\n"
"${DD} 日期，2 位数字\n"
"${hh} 小时，2 位数字\n"
"${mm} 分钟，2 位数字\n"
"${ss} 秒，2 位数字\n"
"${NUM} 递增编号，6 位数字（参见下方的“计数器”）\n"
"${RRR...} 随机字母数字，长度与 R 的个数相同\n"
"${title} 截图标题（如果有）\n"
"${\"affix\"?TOKEN} 仅当 TOKEN 有值时才输出“附加文本＋值”，例如 ${\" - \"?title} 会得到“ - 我的窗口”——若没有标题则什么都不输出\n"
"\n"
"%Y 年份，%y 年份（2 位数字）\n"
"%m 月，%d 日\n"
"%H 小时（24 小时制），%I 小时（12 小时制），%p 上午/下午\n"
"%M 分钟，%S 秒\n"
"%A/%a 星期名称，%B/%b 月份名称\n"
"%% 一个百分号字面量"

