#: src/orcshot/ui/editor_window.py:5717
msgid ""
"${YYYY} year, 4 digits\n"
"${MM} month, 2 digits\n"
"${DD} day, 2 digits\n"
"${hh} hour, 2 digits\n"
"${mm} minute, 2 digits\n"
"${ss} second, 2 digits\n"
"${NUM} incrementing number, 6 digits (see Counter below)\n"
"${RRR...} random alphanumerics, same length as the number of R's\n"
"${title} capture title, when available\n"
"${\"affix\"?TOKEN} renders affix+value only when TOKEN has one, e.g. ${\" - "
"\"?title} for \" - My Window\" - or nothing at all if there's no title\n"
"\n"
"%Y year, %y year (2 digits)\n"
"%m month, %d day\n"
"%H hour (24h), %I hour (12h), %p AM/PM\n"
"%M minute, %S second\n"
"%A/%a weekday name, %B/%b month name\n"
"%% a literal percent sign"
msgstr ""
"${YYYY} वर्ष, 4 अंक\n"
"${MM} महीना, 2 अंक\n"
"${DD} दिन, 2 अंक\n"
"${hh} घंटा, 2 अंक\n"
"${mm} मिनट, 2 अंक\n"
"${ss} सेकंड, 2 अंक\n"
"${NUM} बढ़ता हुआ नंबर, 6 अंक (नीचे काउंटर देखें)\n"
"${RRR...} यादृच्छिक अक्षर-अंक, जितने R लिखे हों उतनी लंबाई\n"
"${title} कैप्चर का शीर्षक, जब उपलब्ध हो\n"
"${\"affix\"?TOKEN} affix और मान तभी दिखाता है जब TOKEN का कोई मान हो, जैसे "
"${\" - \"?title} से \" - My Window\" - और शीर्षक न होने पर कुछ भी नहीं\n"
"\n"
"%Y वर्ष, %y वर्ष (2 अंक)\n"
"%m महीना, %d दिन\n"
"%H घंटा (24 घंटे), %I घंटा (12 घंटे), %p AM/PM\n"
"%M मिनट, %S सेकंड\n"
"%A/%a सप्ताह के दिन का नाम, %B/%b महीने का नाम\n"
"%% प्रतिशत का चिह्न स्वयं"

