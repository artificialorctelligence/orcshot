#: src/orcshot/ui/editor_window.py:5756
msgid ""
"${YYYY} year, 4 digits\n"
"${MM} month, 2 digits\n"
"${DD} day, 2 digits\n"
"${hh} hour, 2 digits\n"
"${mm} minute, 2 digits\n"
"${ss} second, 2 digits\n"
"${NUM} incrementing number, 6 digits (see Counter below)\n"
"${RRR...} random alphanumerics, same length as the number of R's\n"
"${title} capture title, when available\n"
"${\"affix\"?TOKEN} renders affix+value only when TOKEN has one, e.g. ${\" - "
"\"?title} for \" - My Window\" - or nothing at all if there's no title\n"
"\n"
"%Y year, %y year (2 digits)\n"
"%m month, %d day\n"
"%H hour (24h), %I hour (12h), %p AM/PM\n"
"%M minute, %S second\n"
"%A/%a weekday name, %B/%b month name\n"
"%% a literal percent sign"
msgstr ""
"${YYYY} Jahr, 4-stellig\n"
"${MM} Monat, 2-stellig\n"
"${DD} Tag, 2-stellig\n"
"${hh} Stunde, 2-stellig\n"
"${mm} Minute, 2-stellig\n"
"${ss} Sekunde, 2-stellig\n"
"${NUM} fortlaufende Nummer, 6-stellig (siehe „Zähler“ weiter unten)\n"
"${RRR...} zufällige alphanumerische Zeichen, so viele wie angegebene R\n"
"${title} Titel der Aufnahme, sofern vorhanden\n"
"${\"Zusatz\"?TOKEN} gibt Zusatz+Wert nur aus, wenn TOKEN einen Wert hat, z. "
"B. ${\" - \"?title} für \" - Mein Fenster\" – oder gar nichts, wenn es "
"keinen Titel gibt\n"
"\n"
"%Y Jahr, %y Jahr (2-stellig)\n"
"%m Monat, %d Tag\n"
"%H Stunde (24 h), %I Stunde (12 h), %p AM/PM\n"
"%M Minute, %S Sekunde\n"
"%A/%a Wochentagsname, %B/%b Monatsname\n"
"%% ein wörtliches Prozentzeichen"

