__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
build/
dist/
.coverage
htmlcov/

# debian package build artifacts - regenerated fresh by dpkg-buildpackage,
# never the hand-written packaging files themselves (debian/control, rules,
# changelog, copyright, source/format, *.install, *.desktop)
.pybuild/
debian/.debhelper/
debian/debhelper-build-stamp
debian/files
debian/orcshot/
debian/orcshot.debhelper.log
debian/orcshot.postinst.debhelper
debian/orcshot.postrm.debhelper
debian/orcshot.prerm.debhelper
debian/orcshot.substvars

# snapcraft build artifact - regenerated fresh by `snapcraft pack`, never
# the hand-written snapcraft.yaml itself
*.snap

# flatpak-builder build artifacts - regenerated fresh by `flatpak-builder`/
# `flatpak build-bundle`, never the hand-written org.orcshot.Orcshot.yaml
# itself (or the vendored org.gnome.shell.gschema.xml it installs - see
# THIRD_PARTY_NOTICES.md)
build-dir/
.flatpak-builder/
repo/
orcshot.flatpak
orcshot_*.flatpak
org.orcshot.Orcshot.generated-icon.svg

# VM login credentials for local VBoxManage guestcontrol testing - never committed
vmpw.txt

# i18n: po/orcshot.pot is committed for real (phase 2 - TRANSLATING.md
# points contributors at it as the template to translate from), so it's
# deliberately not ignored here anymore. The compiled .mo catalogs are
# a build-time artifact of debian/rules' own override_dh_auto_build
# (compiled from po/*.po into here so hatchling's own wheel build
# picks them up) - never committed, source of truth is po/*.po.
src/orcshot/resources/locale/

# Same as above, for the Wayland tray extension's own separate
# gettext domain (task #183 follow-up) - compiled from
# po/orcshot-tray-*.po by debian/rules, never committed.
src/orcshot/resources/gnome-shell-extensions/orcshot-clipboard@orcshot.org/locale/
