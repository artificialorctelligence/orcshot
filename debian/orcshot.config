#!/bin/sh
set -e

. /usr/share/debconf/confmodule

# Task #141 follow-up: only worth asking at all if there's a live
# graphical session to act on right now - same loginctl-based
# detection debian/orcshot.preinst already uses for task #152's
# prepare-for-upgrade call, narrowed to session Type here specifically
# (a plain SSH/tty login also gets a D-Bus session bus under modern
# systemd, but isn't somewhere a tray icon could actually appear). No
# active Wayland/X11 session - a fresh headless install, or installing
# from a bare TTY before ever logging into the desktop - just skips
# asking, falling through to postinst's own plain "open it from your
# Applications menu" message instead, matching this project's own
# established fallback (see that script's own comment).
#
# Only the first graphical session found is asked about - two
# different users both logged in graphically at once (fast user
# switching, multi-seat) is a genuine edge case for this app's actual
# audience, and asking once per session would need multiple debconf
# prompts for a benefit that doesn't seem worth the complexity.
#
# debconf's own answer-tracking means this won't re-prompt on a
# routine upgrade once it's been answered once, whichever way - no
# extra "already enabled" check needed here for that.
# BACKLOG #203: skip system accounts. A display manager's greeter (gdm,
# lightdm, sddm) has a real uid, a real wayland/x11 session and a real
# session bus, so it matches every test below exactly like a human would -
# and on a machine sitting at the login screen it is the FIRST match, which
# is where the loop stops. Live-observed 2026-09-07: installing with nobody
# logged in left orcshot running as gdm. UID_MIN is the system's own
# definition of "where human accounts start"; 1000 is the Debian/Ubuntu
# default, used only if /etc/login.defs can't be read. The 2>/dev/null on the
# comparison is deliberate: a non-numeric uid makes `[ -ge ]` fail rather than
# abort (the `|| continue` absorbs it even under `set -e`, verified), but it
# would still print "Illegal number" into the middle of an apt install.
uid_min=$(awk '$1 == "UID_MIN" { print $2; exit }' /etc/login.defs 2>/dev/null || true)
[ -n "$uid_min" ] || uid_min=1000
if command -v loginctl >/dev/null 2>&1; then
    for uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}' || true); do
        [ "$uid" -ge "$uid_min" ] 2>/dev/null || continue
        session=$(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$uid" '$2 == u {print $1; exit}')
        [ -n "$session" ] || continue
        type=$(loginctl show-session "$session" -p Type --value 2>/dev/null || echo "")
        if [ "$type" = "wayland" ] || [ "$type" = "x11" ]; then
            db_input high orcshot/enable-autostart || true
            db_go || true
            break
        fi
    done
fi

exit 0
